---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/work';
import Contact from '../components/Contact.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const DEFAULT_DESC =
  "Ray Lai — Design & AI at SUTD. I figure things out: multi-agent AI systems, product design and full-stack engineering, from research at MIT to shipped client products.";
const {
  title = 'Ray Lai — I figure things out',
  description = DEFAULT_DESC,
  image = url('og.jpg'),
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#0d1b2a" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <Contact />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
