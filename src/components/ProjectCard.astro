---
import { Image } from 'astro:assets';
import { accentFor, chipFor, url, type Work } from '../lib/work';

interface Props { work: Work; featured?: boolean }
const { work, featured = false } = Astro.props;
const d = work.data;
const accent = accentFor(work);
const chip = chipFor(work);
const href = url(`work/${work.id}/`);
---
<li class:list={['card', { 'card--featured': featured }]} style={`--accent:${accent}`} data-card data-accent={accent} data-reveal>
  <a class="card__link" href={href}>
    <div class="card__media">
      <Image
        src={d.cover}
        alt={d.coverAlt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, 33vw"
        loading="lazy"
        transition:name={`media-${work.id}`}
      />
    </div>
    <div class="card__body">
      <div class="card__top">
        {chip && <span class="card__chip">{chip}</span>}
        <span class="card__year">{d.year}</span>
      </div>
      <h3 class="card__title">{d.title}</h3>
      <p class="card__tagline">{d.tagline}</p>
      <p class="card__summary">{d.oneLiner}</p>
      {d.tags.length > 0 && (
        <ul class="card__tags" aria-label="Keywords">
          {d.tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
      <span class="card__more" aria-hidden="true">View project →</span>
    </div>
  </a>
</li>

<style>
  .card { list-style: none; position: relative; }
  .card:hover, .card:focus-within { z-index: 2; }
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.03);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.4s var(--ease-out), transform 0.5s var(--ease-out), background-color 0.4s, box-shadow 0.5s var(--ease-out);
  }
  .card__link:hover, .card__link:focus-visible {
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
    background: color-mix(in oklab, var(--accent) 6%, transparent);
    transform: scale(1.04);
    box-shadow: 0 30px 60px -25px color-mix(in oklab, var(--accent) 55%, transparent);
  }
  .card__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .card__media { aspect-ratio: 16 / 10; overflow: hidden; background: #0a0f15; }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .card__link:hover .card__media :global(img) { transform: scale(1.04); }

  .card__body { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.25rem, 2.5vw, 2rem); flex: 1; }
  .card__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .card__chip {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .card__year { font-size: 0.85rem; color: var(--ink-faint); }
  .card__title { font-size: clamp(1.6rem, 2.6vw, 2.4rem); letter-spacing: -0.035em; }
  .card__tagline { font-weight: 600; font-size: 1.05rem; color: var(--ink); margin-top: -0.25rem; }
  .card__summary { color: var(--ink-dim); }
  .card__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 0.25rem; }
  .card__tags li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--ink-dim);
  }

  .card__more { margin-top: auto; padding-top: 0.5rem; font-weight: 600; font-size: 0.9rem; color: var(--accent); }

</style>
